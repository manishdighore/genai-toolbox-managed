# Copy this file to `.env` (which is gitignored) and fill in values before
# starting db-mcp via docker compose or build-run.sh.
#
# NEVER commit `.env` — it holds the master key that decrypts every DB
# password db-mcp has stored. Losing it means re-adding every connection.
# Backing it up is the operator's responsibility.

# ─────────────────────────────────────────────────────────────────────────────
# DBMCP_APP_KEY  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# 32-byte hex master key used by the `credentials` secrets backend.
# db-mcp uses this key to envelope-encrypt the rows it inserts into the
# shared `credentials` Postgres table (rows with type='db_connection').
#
# Generate one with:
#   openssl rand -hex 32
#
# Note: this key is independent of AgentForge's APP_KEY — the two services
# encrypt their own rows in the same table using different master keys.
DBMCP_APP_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Postgres target  (used by docker-compose and build-run.sh as overrides)
# ─────────────────────────────────────────────────────────────────────────────
# Defaults match the AgentForge dev Postgres: agentforge:agentforge@localhost:5432/agentforge.
# Override these only if your Postgres lives somewhere else.
PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=agentforge
PG_PASS=agentforge
PG_DB=agentforge
PG_SSLMODE=disable
